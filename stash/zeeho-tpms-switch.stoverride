name: ZEEHO 胎压设置开关
desc: |-
  向 vehicleSet/items、itemsV2 注入 TIRE_MONITORING，
  让极核 App 车辆设置出现「胎压传感器」入口。
  只改显示开关，不 mock 胎压数据。
author: FlyRenxing
homepage: https://github.com/FlyRenxing/zeeho-tpms-switch
category: Rewrite
date: "2026-10-12"
version: "1.0.1"

http:
  mitm:
    - tapi.zeehoev.com
  script:
    - match: ^https://tapi\.zeehoev\.com/v1\.0/app/cfmotoserverapp/vehicleSet/items
      name: zeeho-tpms-switch
      type: response
      require-body: true
      timeout: 10
      binary-mode: false
      max-size: 1048576

script-providers:
  zeeho-tpms-switch:
    url: https://cdn.jsdelivr.net/gh/FlyRenxing/zeeho-tpms-switch@main/scripts/zeeho-tpms-switch.js
    interval: 86400
    payload: |
      /**
       * ZEEHO / 极核：在 vehicleSet/items、itemsV2 响应里注入 TIRE_MONITORING，
       * 让车辆设置出现「胎压传感器」入口。
       *
       * 只改这个显示开关。不 mock 胎压读数、预警范围、首页或 carSet。
       *
       * 兼容 Stash / Loon / Surge（$response + $done）。
       */
      
      function hasCode(list, code) {
        if (!Array.isArray(list)) return false;
        for (var i = 0; i < list.length; i++) {
          if (list[i] && list[i].functionCode === code) return true;
        }
        return false;
      }
      
      function capabilityItem() {
        return {
          functionCode: "TIRE_MONITORING",
          sortNum: 1,
          isSupport: true,
          isSupportSetting: true,
          isSupportBlueTooth: false
        };
      }
      
      function settingsItem() {
        return {
          functionCode: "TIRE_MONITORING",
          functionIconUrl: null,
          functionName: "胎压传感器",
          describe: null,
          subFunctions: [],
          type: 1
        };
      }
      
      function injectTireMonitoring(body) {
        if (!body || typeof body !== "object") return body;
      
        // vehicleSet/items：data 是功能数组
        if (Array.isArray(body.data)) {
          if (!hasCode(body.data, "TIRE_MONITORING")) {
            body.data.unshift(capabilityItem());
          }
          return body;
        }
      
        if (!body.data) return body;
      
        var data = body.data;
      
        // vehicleSet/itemsV2：能力列表 + 设置宫格
        if (Array.isArray(data.vehicleTypeDetailFunctionVOList) && !hasCode(data.vehicleTypeDetailFunctionVOList, "TIRE_MONITORING")) {
          data.vehicleTypeDetailFunctionVOList.unshift(capabilityItem());
        }
      
        if (Array.isArray(data.vehicleSetFunctionVOList)) {
          var item = settingsItem();
          if (data.vehicleSetFunctionVOList.length === 0) {
            data.vehicleSetFunctionVOList.push([item]);
          } else {
            var first = data.vehicleSetFunctionVOList[0];
            if (Array.isArray(first) && !hasCode(first, "TIRE_MONITORING")) {
              first.unshift(item);
            }
          }
        }
      
        return body;
      }
      
      function parseBody(raw) {
        if (raw == null) return null;
        if (typeof raw === "object") return raw;
        if (typeof raw !== "string") return null;
        try {
          return JSON.parse(raw);
        } catch (e) {
          return null;
        }
      }
      
      function rewriteBody(raw) {
        var parsed = parseBody(raw);
        if (!parsed) return null;
        return JSON.stringify(injectTireMonitoring(parsed));
      }
      
      if (typeof $done === "function" && typeof $response !== "undefined") {
        var next = rewriteBody($response.body);
        if (typeof console !== "undefined" && console.log) {
          console.log("[ZEEHO TPMS] " + ((typeof $request !== "undefined" && $request.url) || "") + (next ? " rewritten" : " skipped"));
        }
        if (next == null) {
          $done({});
        } else {
          $done({ body: next });
        }
      }
      
      if (typeof module !== "undefined" && module.exports) {
        module.exports = {
          hasCode: hasCode,
          injectTireMonitoring: injectTireMonitoring,
          parseBody: parseBody,
          rewriteBody: rewriteBody
        };
      }
      
